// Prisma-Schema für das Nebenkostenabrechnungs-Portal der Hausverwaltung Müller GmbH.
//
// Konventionen:
// - Alle Geldbeträge werden als Int in Cent gespeichert (keine Float-Rundungsfehler).
// - IDs sind cuid()-Strings.
// - Enums bilden die Status-Felder der jeweiligen Prozessschritte ab.
// - onDelete-Verhalten ist bewusst gewählt: Stammdaten (Property/Unit/Tenancy)
//   werden i.d.R. restrict/cascade je nach fachlicher Abhängigkeit, historische
//   Belege (Document, AuditLog) bleiben bei Löschung übergeordneter Objekte
//   nach Möglichkeit erhalten (SetNull) statt verwaist zu kaskadieren, wo dies
//   rechtlich/prüfungsrelevant ist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Benutzer & Rollen
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  HAUSVERWALTUNG
  EIGENTUEMER
  MIETER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // Argon2id-Hash; null bei rein eingeladenen/nicht aktivierten Accounts
  name          String?
  role          UserRole  @default(EIGENTUEMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedProperties Property[]       @relation("PropertyOwnerUser")
  tenancies       Tenancy[]        @relation("TenancyUser")
  documents       Document[]       @relation("DocumentUploadedBy")
  aiUsageLogs     AiUsageLog[]
  auditLogs       AuditLog[]
  billingRunsUser BillingRun[]     @relation("BillingRunCreatedBy")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Objekte, Einheiten, Mietverhältnisse
// ---------------------------------------------------------------------------

enum PropertyType {
  WEG
  MIETSHAUS
  GEMISCHT
}

model Property {
  id           String       @id @default(cuid())
  name         String
  type         PropertyType
  street       String
  houseNumber  String
  postalCode   String
  city         String
  country      String       @default("DE")
  totalArea    Decimal?     @db.Decimal(10, 2) // Gesamtwohn-/Nutzfläche in m²
  ownerUserId  String?
  ownerUser    User?        @relation("PropertyOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  units             Unit[]
  billingRuns       BillingRun[]
  costItems         CostItem[]
  allocationKeys    AllocationKey[]
  externalHeatingStatements ExternalHeatingStatement[]
  documents         Document[]

  @@index([ownerUserId])
}

model Unit {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label        String // z.B. "1. OG links"
  area         Decimal  @db.Decimal(10, 2) // m²
  miteigentumsanteile Int? // MEA für WEG, in Tausendsteln o.ä., optional
  persons      Int? // Standardpersonenzahl, kann je Tenancy überschrieben werden
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenancies    Tenancy[]
  unitStatements UnitStatement[]

  @@index([propertyId])
}

enum TenancyStatus {
  AKTIV
  BEENDET
  GEPLANT
}

model Tenancy {
  id          String        @id @default(cuid())
  unitId      String
  unit        Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation("TenancyUser", fields: [userId], references: [id], onDelete: SetNull)
  tenantName  String // Freitext-Name, falls kein User-Account vorhanden
  tenantEmail String?
  startDate   DateTime
  endDate     DateTime?
  status      TenancyStatus @default(AKTIV)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  occupancies    TenancyOccupancy[]
  unitStatements UnitStatement[]
  payments       Payment[]

  @@index([unitId])
  @@index([userId])
}

// Zeitraumbezogene Belegung innerhalb eines Mietverhältnisses (z.B. Personenzahl-
// Änderungen während der Abrechnungsperiode), wird für taggenaue Umlage benötigt.
model TenancyOccupancy {
  id         String   @id @default(cuid())
  tenancyId  String
  tenancy    Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  fromDate   DateTime
  toDate     DateTime?
  persons    Int
  createdAt  DateTime @default(now())

  @@index([tenancyId])
}

// ---------------------------------------------------------------------------
// Abrechnungslauf, Kosten, Umlageschlüssel
// ---------------------------------------------------------------------------

enum BillingRunStatus {
  ENTWURF
  IN_BEARBEITUNG
  PRUEFUNG
  FREIGEGEBEN
  VERSENDET
  ABGESCHLOSSEN
  STORNIERT
}

model BillingRun {
  id            String           @id @default(cuid())
  propertyId    String
  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  status        BillingRunStatus @default(ENTWURF)
  createdByUserId String?
  createdByUser User?            @relation("BillingRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  costItems       CostItem[]
  unitStatements  UnitStatement[]
  documents       Document[]
  invoices        Invoice[]

  @@index([propertyId])
  @@index([status])
}

enum CostCategoryType {
  HEIZUNG
  WARMWASSER
  KALTWASSER
  ABWASSER
  MUELLABFUHR
  STRASSENREINIGUNG
  GEBAEUDEREINIGUNG
  GARTENPFLEGE
  BELEUCHTUNG
  SCHORNSTEINFEGER
  SACH_HAFTPFLICHTVERSICHERUNG
  HAUSWART
  AUFZUG
  ANTENNE_KABEL
  WASCHEINRICHTUNG
  SONSTIGE
}

model CostCategory {
  id          String           @id @default(cuid())
  type        CostCategoryType @unique
  label       String
  description String?

  costItems CostItem[]

  @@index([type])
}

enum AllocationMethod {
  WOHNFLAECHE
  PERSONEN
  MITEIGENTUMSANTEILE
  VERBRAUCH
  EINHEITEN
  DIREKT
  INDIVIDUELL
}

model AllocationKey {
  id         String           @id @default(cuid())
  propertyId String
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  method     AllocationMethod
  label      String
  createdAt  DateTime         @default(now())

  costItems CostItem[]

  @@index([propertyId])
}

model CostItem {
  id              String        @id @default(cuid())
  billingRunId    String
  billingRun      BillingRun    @relation(fields: [billingRunId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryId      String
  category        CostCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  allocationKeyId String
  allocationKey   AllocationKey @relation(fields: [allocationKeyId], references: [id], onDelete: Restrict)
  description     String?
  amountNetCent   Int // Nettobetrag in Cent
  amountVatCent   Int @default(0) // enthaltene USt in Cent
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([billingRunId])
  @@index([propertyId])
  @@index([categoryId])
  @@index([allocationKeyId])
}

// Externe Heizkosten-Abrechnung (z.B. von Messdienstleistern wie Techem/Ista),
// die als Grundlage/Referenz für die Heizkosten-Position importiert wird.
model ExternalHeatingStatement {
  id            String    @id @default(cuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider      String // z.B. "Techem", "Ista"
  periodStart   DateTime
  periodEnd     DateTime
  documentId    String?   @unique
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  totalCostCent Int
  importedData  Json? // strukturierte, per KI-Extraktion gewonnene Rohdaten (siehe src/lib/ai)
  createdAt     DateTime  @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Einzelabrechnung je Einheit
// ---------------------------------------------------------------------------

enum UnitStatementStatus {
  ENTWURF
  BERECHNET
  FREIGEGEBEN
  VERSENDET
  BEZAHLT
  STORNIERT
}

model UnitStatement {
  id                 String              @id @default(cuid())
  billingRunId       String
  billingRun         BillingRun          @relation(fields: [billingRunId], references: [id], onDelete: Cascade)
  unitId             String
  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenancyId          String?
  tenancy            Tenancy?            @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  status             UnitStatementStatus @default(ENTWURF)
  totalCostCent      Int // umgelegte Gesamtkosten dieser Einheit, in Cent
  prepaymentCent     Int // geleistete Vorauszahlungen, in Cent
  balanceCent        Int // Saldo (positiv = Nachzahlung, negativ = Guthaben), in Cent
  calculationDetails Json? // Nachvollziehbare Rechenwege je Kostenposition
  documentId         String?             @unique
  document           Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  payments Payment[]

  @@index([billingRunId])
  @@index([unitId])
  @@index([tenancyId])
}

// ---------------------------------------------------------------------------
// Dokumente (Belege, PDFs, hochgeladene Unterlagen)
// ---------------------------------------------------------------------------

enum DocumentType {
  BELEG
  ABRECHNUNG_PDF
  HEIZKOSTENABRECHNUNG_EXTERN
  SONSTIGES
}

model Document {
  id             String       @id @default(cuid())
  type           DocumentType
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String // Schlüssel/Pfad im Storage-Backend (siehe src/lib/storage)
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  billingRunId   String?
  billingRun     BillingRun?  @relation(fields: [billingRunId], references: [id], onDelete: SetNull)
  uploadedByUserId String?
  uploadedByUser User?        @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  externalHeatingStatement ExternalHeatingStatement?
  unitStatement            UnitStatement?

  @@index([propertyId])
  @@index([billingRunId])
  @@index([uploadedByUserId])
}

// ---------------------------------------------------------------------------
// Zahlungen & Rechnungen (Portalgebühren, siehe .env PRICE_*)
// ---------------------------------------------------------------------------

enum PaymentProvider {
  STRIPE
  PAYPAL
  UEBERWEISUNG
}

enum PaymentStatus {
  OFFEN
  IN_BEARBEITUNG
  BEZAHLT
  FEHLGESCHLAGEN
  ERSTATTET
  STORNIERT
}

model Payment {
  id                String          @id @default(cuid())
  tenancyId         String?
  tenancy           Tenancy?        @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  unitStatementId   String?
  unitStatement     UnitStatement?  @relation(fields: [unitStatementId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider          PaymentProvider
  providerReference String? // externe Transaktions-/Charge-ID
  amountCent        Int
  status            PaymentStatus   @default(OFFEN)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenancyId])
  @@index([unitStatementId])
  @@index([invoiceId])
  @@index([status])
}

enum InvoiceStatus {
  ENTWURF
  VERSENDET
  BEZAHLT
  STORNIERT
}

model Invoice {
  id              String        @id @default(cuid())
  billingRunId    String?
  billingRun      BillingRun?   @relation(fields: [billingRunId], references: [id], onDelete: SetNull)
  invoiceNumber   String        @unique
  recipientName   String
  amountNetCent   Int
  vatRateBps      Int // Umsatzsteuersatz in Basispunkten (z.B. 1900 = 19,00 %)
  amountVatCent   Int
  amountGrossCent Int
  status          InvoiceStatus @default(ENTWURF)
  issuedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments Payment[]

  @@index([billingRunId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// KI-Nutzung & Audit
// ---------------------------------------------------------------------------

enum AiUsageKind {
  EXTRAKTION
  ANALYSE
}

model AiUsageLog {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           AiUsageKind
  model          String // z.B. Wert aus ANTHROPIC_MODEL_EXTRACT / ANTHROPIC_MODEL_ANALYZE
  inputTokens    Int?
  outputTokens   Int?
  documentId     String?
  costEstimateCent Int? // geschätzte Kosten in Cent, falls berechenbar
  createdAt      DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([kind])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // z.B. "billing_run.approve", "unit_statement.send"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
