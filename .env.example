# Diese Datei enthält AUSSCHLIESSLICH Platzhalter, keine echten Zugangsdaten.
# Kopiere sie zu .env und trage die tatsächlichen Werte ein. .env darf niemals
# committet werden (siehe .gitignore).

# --- Datenbank -----------------------------------------------------------
# MySQL 8. Beispiel: mysql://user:password@localhost:3306/nebenkostenki
DATABASE_URL="mysql://user:password@localhost:3306/nebenkostenki"

# --- Auth.js ---------------------------------------------------------------
# Zufälliger, langer Secret-String (z.B. `openssl rand -base64 32`).
AUTH_SECRET="changeme"
# Öffentliche Basis-URL der Anwendung, z.B. https://portal.muellerhv.de
APP_URL="http://localhost:3000"

# --- KI (Anthropic) ---------------------------------------------------------
# Siehe src/lib/ai/client.ts: Vor Produktivbetrieb AVV/DPA mit Anthropic klären.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_EXTRACT="claude-sonnet-4-5"
ANTHROPIC_MODEL_ANALYZE="claude-sonnet-4-5"
# Tageslimit an KI-Anfragen pro Nutzer (Kosten-/Missbrauchsschutz).
AI_DAILY_LIMIT_PER_USER="20"

# --- Storage -----------------------------------------------------------------
# "local" (Default) oder "s3".
STORAGE_DRIVER="local"

# --- Zahlungen: Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Zahlungen: PayPal --------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# --- Portal-Preise (Netto, in Cent) ------------------------------------------
PRICE_PER_UNIT_STATEMENT_NET_CENT="0"
PRICE_BASE_NET_CENT="0"
# Umsatzsteuersatz, z.B. 0.19 für 19 %.
VAT_RATE="0.19"

# --- E-Mail-Versand (SMTP) ----------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Firmendaten der Hausverwaltung Müller GmbH (für Dokumente/Rechnungen) ---
# Niemals mit erfundenen Werten befüllen. Nur exakt geprüfte Angaben eintragen.
HVM_TAX_ID=""
HVM_VAT_ID=""
HVM_IBAN=""
HVM_BIC=""

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=""
