##############################################################################
# Smart Abrechnen - Umgebungskonfiguration (Beispiel)
#
# Diese Datei enthaelt ausschliesslich Platzhalter. Echte Geheimnisse gehoeren
# niemals in das Repository, sondern nur in die .env des Zielsystems oder in
# den Secret Store der CI. Jede Variable ist in README.md und ARCHITECTURE.md
# dokumentiert.
##############################################################################

# --- Anwendung ---------------------------------------------------------------
APP_NAME="Smart Abrechnen"
APP_ENV=production
# Mit "php artisan key:generate" erzeugen
APP_KEY=
APP_DEBUG=false
# Kanonische Produktiv-URL. www leitet dauerhaft hierauf um.
APP_URL=https://smart-abrechnen.de
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

# --- Datenbank ---------------------------------------------------------------
# Zielsystem ist MariaDB 10.11 LTS oder 11.x. Laravel nutzt technisch den
# MySQL-PDO-Treiber; der Connection-Name "mariadb" erzeugt MariaDB-konforme
# Grammatik. "mysql" funktioniert ebenfalls, siehe ARCHITECTURE.md (ADR-003).
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, Queue, Cache --------------------------------------------------
# Datenbankgestuetzt, damit IONOS Profil A ohne Redis funktioniert.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# --- Dateiablage -------------------------------------------------------------
# Ergebnisartefakte (erzeugte PDFs, ZIPs, HVM-Rechnungen) liegen auf SFTP.
# Originaluploads liegen ausschliesslich auf der Disk "temporary_uploads"
# und werden nach der Auswertung automatisch geloescht.
FILESYSTEM_DISK=sftp
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
# Alternative zur Passwortauthentifizierung. Nie beide Wege gleichzeitig aktivieren.
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSPHRASE=
SFTP_ROOT=/privater/pfad/smart-abrechnen/artifacts
SFTP_TIMEOUT=20

# Optionaler EU-Objektspeicher, ausschliesslich fuer erzeugte Systemartefakte.
S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- E-Mail (IONOS SMTP) -----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.de
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=kontakt@smart-abrechnen.de
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=kontakt@smart-abrechnen.de
MAIL_FROM_NAME="Hausverwaltung Müller GmbH"
MAIL_REPLY_TO_ADDRESS=kontakt@smart-abrechnen.de

# --- KI-Provider -------------------------------------------------------------
# Providerabstraktion mit einem Primaerprovider. Fallback nur bei technischem
# Fehler, Rate Limit, nicht unterstuetztem Dateityp oder Schema-Verletzung.
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
AI_FALLBACK_ENABLED=true
AI_DUAL_REVIEW_ENABLED=false
# Produktiv verbindlich. Solange die Providerorganisation nicht nachweislich
# fuer Zero Data Retention beziehungsweise eine gleichwertig freigegebene
# Kurzzeitverarbeitung konfiguriert ist, bleibt AI_DATA_RETENTION_APPROVED=false
# und der Provider wird produktiv blockiert.
AI_REQUIRE_ZERO_DATA_RETENTION=true
AI_DATA_RETENTION_APPROVED=false

OPENAI_API_KEY=
# Modellnamen sind ueber ENV austauschbar und vor Livegang gegen die
# Modellliste des Providers zu pruefen (Admin-Healthcheck).
OPENAI_MODEL_EXTRACT=gpt-5.6-luna
OPENAI_MODEL_ANALYZE=gpt-5.6-terra
OPENAI_STORE_RESPONSES=false

ANTHROPIC_API_KEY=
# Guenstiges Modell fuer Klassifikation und einfache Extraktion.
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5
# Starkes Modell fuer Vertraege, komplexe Tabellen und Reconciliation.
# Hinweis: claude-sonnet-5 ist bei geringeren Tokenkosten leistungsfaehiger
# als claude-sonnet-4-6, siehe ARCHITECTURE.md (ADR-009).
ANTHROPIC_MODEL_ANALYZE=claude-sonnet-5

AI_CONFIDENCE_REVIEW_THRESHOLD=0.80
AI_MAX_DAILY_COST_CENT_PER_USER=
AI_MAX_RETRIES=2
# Notschalter: false laesst die automatische Auswertung ruhen, ohne dass
# Originaldateien liegen bleiben. Leer bedeutet: produktiv gebunden.
AI_BIND_DOCUMENT_PIPELINE=

# --- Zahlung (Stripe) --------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- Preislogik --------------------------------------------------------------
# Verbraucherpreise werden brutto angezeigt. Netto und Umsatzsteuer werden im
# Checkout und auf der HVM-Rechnung getrennt ausgewiesen.
PRICE_PER_STATEMENT_GROSS_CENT=2490
PRICE_BASE_GROSS_CENT=0
VAT_RATE_PERCENT=19

# --- Betreiberangaben (Pflichtangaben, vor Livegang bestaetigen) -------------
HVM_LEGAL_NAME="Hausverwaltung Müller GmbH"
HVM_ADDRESS_LINE="Rheinpromenade 13"
HVM_POSTAL_CODE=40789
HVM_CITY="Monheim am Rhein"
HVM_REGISTER_COURT="Amtsgericht Düsseldorf"
HVM_REGISTER_NUMBER="HRB 104762"
HVM_MANAGING_DIRECTOR="Timo Müller"
HVM_WEBSITE=https://www.muellerhv.de/
# Solange leer, rendert die Rechnung sichtbar "[vor Livegang ergaenzen]" und
# der Adminbereich zeigt einen Livegang-Blocker.
HVM_TAX_ID=
HVM_VAT_ID=
HVM_IBAN=
HVM_BIC=
# Bestaetigung der Betreiber-, Steuer- und Bankdaten durch die Geschaeftsfuehrung.
HVM_MASTERDATA_CONFIRMED=false

# --- Rechnungsnummernkreis ---------------------------------------------------
INVOICE_NUMBER_PREFIX=NK
INVOICE_NUMBER_PADDING=6

# --- Erinnerungen (Zeitzone Europe/Berlin) -----------------------------------
REMINDER_ENABLED=true
REMINDER_Q1_DATE=01-15
REMINDER_Q2_DATE=04-15
REMINDER_Q3_DATE=07-15
REMINDER_DECEMBER_DATE=12-01

# --- Uploads, Aufbewahrung und Loeschung -------------------------------------
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_RUN_MB=250
UPLOAD_CHUNK_SIZE_MB=4
# clamav | external | disabled. "disabled" ist nur lokal zulaessig und erzeugt
# produktiv einen sichtbaren Admin-Blocker.
MALWARE_SCANNER_DRIVER=disabled
MALWARE_SCANNER_ENDPOINT=
# Kurzzeit-TTL fuer Originaluploads. Beginnt mit Eingang des ersten Chunks und
# darf 120 Minuten nicht ueberschreiten.
TEMP_UPLOAD_TTL_MINUTES=120
TEMP_CLEANUP_INTERVAL_MINUTES=10
AI_PROVIDER_FILE_TTL_MINUTES=30
# Leer bedeutet: unbefristet bis zur dokumentierten Betreiberentscheidung.
EXTRACTED_DATA_RETENTION_DAYS=
GENERATED_PDF_RETENTION_DAYS=
SIGNED_DOWNLOAD_TTL_MINUTES=30

# --- Logging und Monitoring --------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Vite / Assets -----------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
