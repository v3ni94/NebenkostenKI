<IfModule mod_rewrite.c>
    # Kein "Options"-Befehl: IONOS Webhosting erlaubt ihn in Kundenverzeichnissen
    # nicht (AllowOverride ohne Options) und antwortet sonst mit Fehler 500.
    # Verzeichnislisten verhindert die Rewrite-Regel auf index.php, MultiViews
    # ist auf IONOS nicht aktiv.

    RewriteEngine On

    # www dauerhaft auf die kanonische Domain umleiten (Masterprompt 3.1).
    # Die Zieldomain wird aus dem angefragten Host abgeleitet, nichts ist hart
    # codiert. Pfad und Query bleiben erhalten. Zweite Verteidigungslinie ist
    # App\Http\Middleware\RedirectToCanonicalHost.
    #
    # Nur im ersten Durchlauf (REDIRECT_STATUS leer): Nach einer internen
    # Umschreibung, etwa aus der Wurzel-.htaccess nach current/public/ oder
    # nach index.php, traegt %{REQUEST_URI} bereits den umgeschriebenen Pfad.
    # Ein Redirect aus dem zweiten Durchlauf wuerde den internen Pfad
    # /current/public/... in die Adresszeile des Browsers schreiben.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    # Ebenfalls nur im ersten Durchlauf, siehe oben.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Versteckte Dateien im Webroot werden nie ausgeliefert.
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
